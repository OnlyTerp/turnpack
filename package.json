{
  "name": "turnpack",
  "version": "0.1.0",
  "description": "Fewer back-and-forth AI turns. A local MCP server that gathers context in one call and ships multi-file edits behind your tests, with automatic byte-exact rollback.",
  "license": "Apache-2.0",
  "author": "OnlyTerp (https://github.com/OnlyTerp)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlyTerp/turnpack.git"
  },
  "homepage": "https://github.com/OnlyTerp/turnpack#readme",
  "bugs": {
    "url": "https://github.com/OnlyTerp/turnpack/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "ai-coding",
    "claude-code",
    "claude-desktop",
    "codex",
    "chatgpt",
    "oh-my-pi",
    "grok",
    "cursor",
    "gemini-cli",
    "apply-patch",
    "context-packing",
    "rollback",
    "developer-tools",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "turnpack": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "extensions",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "node dist/cli.js demo",
    "doctor": "node dist/cli.js doctor",
    "bench": "node bench/run-local-bench.mjs",
    "bench:agents": "npm run build && node bench/agent-bench.mjs",
    "bundle": "npm run build && node scripts/build-mcpb.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "verify": "npm test && npm run check:leak",
    "prepublishOnly": "npm run verify"
  }
}
